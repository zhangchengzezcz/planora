    "A local task backup is created before the curriculum changes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A local task backup is created before the curriculum changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カリキュラムを変更する前に、ローカルのタスクバックアップが作成されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换课程体系前会先创建本地任务备份。"
          }
        }
      }
    },
    "A study planner for IB and IGCSE students. Choose your curriculum and subjects first, then the home page helps you see tasks, progress, and important dates clearly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A study planner for IB and IGCSE students. Choose your curriculum and subjects first, then the home page helps you see tasks, progress, and important dates clearly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IB と IGCSE の学生向け学習プランナーです。最初にカリキュラムと科目を選ぶと、ホームでタスク、進捗、重要な日付を見やすく整理できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 IB 与 IGCSE 学生准备的学习规划工具。先选择课程和科目，之后主页会帮你看清任务、进度与重要日期。"
          }
        }
      }
    },
